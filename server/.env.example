# PassBy auth service. Copy to a private file (mode 0600); never commit real values.
# See server/README.md.

# Listen address. Defaults: 127.0.0.1 and 7280.
HOST=127.0.0.1
PORT=7280

# SQLite file for sessions. Default: /data/sessions.sqlite.
SESSION_DB=/data/sessions.sqlite

# Accepted Tenon issuers, separated by spaces. Default: https://account.tenonai.cn/api/auth.
TENON_ISSUERS=https://account.tenonai.cn/api/auth

# OIDC clients registered with Tenon (confidential). Required.
TENON_CLIENT_ID=
TENON_CLIENT_SECRET=
TENON_IOS_CLIENT_ID=
TENON_IOS_CLIENT_SECRET=

# Optional second web client; leave unset to turn it off.
TENON_WEB_CLIENT_ID=
TENON_WEB_CLIENT_SECRET=
