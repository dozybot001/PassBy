<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: also accepts a certificate installed on the test phone, so that the request AI
  grouping sends can be inspected. The released app uses src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
